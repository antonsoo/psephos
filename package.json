{
  "name": "@antonsoloviev/psephos",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Operate Athenian jury attendance, row allotment and concealed voting; read the Greek and inspect the exact chances.",
  "author": "Anthony Mercer <anthony@praviel.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antonsoo/psephos.git"
  },
  "homepage": "https://antonsoo.github.io/psephos/",
  "keywords": [
    "ancient-greek",
    "athens",
    "law",
    "ballots",
    "aristotle",
    "education",
    "history",
    "sortition",
    "probability"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4382 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/offline.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4381 --strictPort",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify:sources": "node scripts/verify-sources.mjs",
    "test:browser": "node scripts/browser.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run verify:sources && npm run build",
    "test:audit": "node scripts/offline-audit.mjs",
    "test:public": "node scripts/public-browser.mjs",
    "test:allotment": "node scripts/allotment-browser.mjs",
    "verify:allotment-source": "python3 scripts/verify-allotment-sources.py",
    "test:allotment-audit": "node scripts/allotment-audit.mjs",
    "test:attendance": "node scripts/attendance-browser.mjs",
    "test:attendance-faults": "node scripts/attendance-faults.mjs",
    "test:update": "node scripts/update-journey.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}

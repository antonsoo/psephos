{
  "name": "@antonsoloviev/psephos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cast a concealed Athenian jury ballot, count the right urn, and read the Greek that decides a tie.",
  "author": "Anthony Mercer <anthony@praviel.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antonsoo/psephos.git"
  },
  "homepage": "https://antonsoo.github.io/psephos/",
  "keywords": [
    "ancient-greek",
    "athens",
    "law",
    "ballots",
    "aristotle",
    "education",
    "history"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4382 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/offline.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4381 --strictPort",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify:sources": "node scripts/verify-sources.mjs",
    "test:browser": "node scripts/browser.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run verify:sources && npm run build",
    "test:audit": "node scripts/offline-audit.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
